[input_devices]

pointing/emulate_touch_from_mouse=true

[internationalization]

locale/translations_pot_files=PackedStringArray("res://assets/dialogues/1.dialogue", "res://Boss1.dialogue", "res://assets/dialogues/2.dialogue", "res://assets/dialogues/3.dialogue", "res://assets/dialogues/4.dialogue", "res://assets/dialogues/5.dialogue", "res://assets/dialogues/6.dialogue", "res://assets/dialogues/7.dialogue", "res://assets/dialogues/8.dialogue", "res://assets/dialogues/9.dialogue", "res://assets/dialogues/10.dialogue", "res://addons/dialogue_manager/Boss2.dialogue", "res://Boss4.dialogue", "res://Boss3.dialogue")

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="mobile"
textures/vram_compression/import_etc2_astc=true
